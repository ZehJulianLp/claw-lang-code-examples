;; Kneif am Kabel! Start with ./claw-cli krebs-arcade/arcade.claw
(defun-foreign 'dlopen (list c-pointer c-sint32) c-pointer)
(defun-foreign 'getenv (list c-pointer) c-pointer)
(defun-foreign 'write (list c-sint32 c-pointer c-uint64) c-sint64)
(defun-foreign 'strlen (list c-pointer) c-uint64)
(defun-foreign 'usleep (list c-uint32) c-sint32)
(defun-foreign 'exit (list c-sint32) c-void)

;; Keep the list constructor available when list operations bind their list argument.
(set 'sequence list)
;; RTLD_NOW | RTLD_GLOBAL makes the library's symbols visible to defun-foreign.
(set 'load-flags 258)
(set 'katzi-library (dlopen (to-cstr "./krebs-arcade/libkerror.so") load-flags))
(if (== katzi-library 0)
    (set 'katzi-library (dlopen (to-cstr "./libkerror.so") load-flags)))
(if (!= katzi-library 0)
    (sequence
        (defun-foreign 'kerror_init () c-void)
        (defun-foreign 'kerror_pull () c-sint32)
        (defun-foreign 'kerror_close () c-void)
        (defun-foreign 'kerror_set_title (list c-pointer) c-void)
        (defun-foreign 'kerror_set_text (list c-pointer) c-void)
        (defun-foreign 'kerror_set_buttoncount (list c-sint32) c-void)
        (defun-foreign 'kerror_set_button1 (list c-pointer) c-void)
        (defun-foreign 'kerror_set_button2 (list c-pointer) c-void)))

(set 'dialog-response 0)
(set 'error-title (to-cstr "Kneif am Kabel: Startfehler"))
(set 'missing-raylib-text (to-cstr "Raylib konnte nicht geladen werden."))
(set 'no-desktop-text (to-cstr "Keine Verbindung zum Desktop."))
(set 'window-error-text (to-cstr "Das Spielfenster konnte nicht starten."))
(set 'dialog-ok (to-cstr "OK"))
(set 'dialog-quit (to-cstr "Beenden"))
(set 'dialog-retry (to-cstr "Nochmal"))
(set 'line-break (to-cstr "
"))

(defun 'show-dialog (dialog-title dialog-text dialog-buttons)
    (sequence
        (set 'dialog-response 0)
        (if (!= katzi-library 0)
            (sequence
                ;; Set the labels before opening the window, including on X11.
                (kerror_set_title dialog-title)
                (kerror_set_text dialog-text)
                (kerror_set_buttoncount dialog-buttons)
                (kerror_set_button1 (if (== dialog-buttons 1) dialog-ok dialog-quit))
                (kerror_set_button2 dialog-retry)
                (kerror_init)
                (while (== dialog-response 0)
                    (sequence
                        (set 'dialog-response (kerror_pull))
                        (if (== dialog-response 0) (usleep 16000))))
                (kerror_close)))))

(defun 'startup-error (error-message)
    (sequence
        (write 2 error-message (strlen error-message))
        (write 2 line-break 1)
        (show-dialog error-title error-message 1)
        (exit 1)))

(if (== (dlopen (to-cstr "libraylib.so") load-flags) 0)
    (startup-error missing-raylib-text))

;; Some Raylib builds can crash inside InitWindow when the display is unreachable.
(set 'desktop-ready false)
(set 'display-probe 0)
(if (and (!= (getenv (to-cstr "DISPLAY")) 0)
         (!= (dlopen (to-cstr "libX11.so.6") load-flags) 0))
    (sequence
        (defun-foreign 'XInitThreads () c-sint32)
        (defun-foreign 'XOpenDisplay (list c-pointer) c-pointer)
        (defun-foreign 'XCloseDisplay (list c-pointer) c-sint32)
        (XInitThreads)
        (set 'display-probe (XOpenDisplay 0))
        (if (!= display-probe 0)
            (sequence (XCloseDisplay display-probe) (set 'desktop-ready true)))))
(if (and (not desktop-ready) (!= (getenv (to-cstr "WAYLAND_SOCKET")) 0))
    (set 'desktop-ready true))
(if (and (not desktop-ready) (!= (getenv (to-cstr "WAYLAND_DISPLAY")) 0)
         (!= (dlopen (to-cstr "libwayland-client.so.0") load-flags) 0))
    (sequence
        (defun-foreign 'wl_display_connect (list c-pointer) c-pointer)
        (defun-foreign 'wl_display_disconnect (list c-pointer) c-void)
        (set 'display-probe (wl_display_connect 0))
        (if (!= display-probe 0)
            (sequence (wl_display_disconnect display-probe) (set 'desktop-ready true)))))
(if (not desktop-ready) (startup-error no-desktop-text))

(defun-foreign 'InitWindow (list c-sint32 c-sint32 c-pointer) c-void)
(defun-foreign 'IsWindowReady () c-uint8)
(defun-foreign 'CloseWindow () c-void)
(defun-foreign 'WindowShouldClose () c-uint8)
(defun-foreign 'SetTargetFPS (list c-sint32) c-void)
(defun-foreign 'EnableEventWaiting () c-void)
(defun-foreign 'DisableEventWaiting () c-void)
(defun-foreign 'IsKeyPressed (list c-sint32) c-uint8)
(defun-foreign 'GetRandomValue (list c-sint32 c-sint32) c-sint32)
(defun-foreign 'BeginDrawing () c-void)
(defun-foreign 'EndDrawing () c-void)
;; Raylib passes four RGBA bytes by value. On little-endian Linux pack them as ABGR.
(defun-foreign 'ClearBackground (list c-uint32) c-void)
(defun-foreign 'DrawRectangle (list c-sint32 c-sint32 c-sint32 c-sint32 c-uint32) c-void)
(defun-foreign 'DrawCircle (list c-sint32 c-sint32 c-float c-uint32) c-void)
(defun-foreign 'DrawEllipse (list c-sint32 c-sint32 c-float c-float c-uint32) c-void)
(defun-foreign 'DrawLine (list c-sint32 c-sint32 c-sint32 c-sint32 c-uint32) c-void)
(defun-foreign 'DrawText (list c-pointer c-sint32 c-sint32 c-sint32 c-uint32) c-void)
(defun-foreign 'MeasureText (list c-pointer c-sint32) c-sint32)
(defun-foreign 'free (list c-pointer) c-void)

(set 'ink 0xFF201720)
(set 'panel 0xFF2F222F)
(set 'track 0xFF3B2C40)
(set 'active-track 0xFF4F384E)
(set 'edge 0xFF614B67)
(set 'paper 0xFFF5E9FC)
(set 'muted 0xFFCBADCE)
(set 'coral 0xFF6B63FF)
(set 'dark-coral 0xFF5043CF)
(set 'mint 0xFFC8F087)
(set 'gold 0xFF86D5FF)

(set 'window-title (to-cstr "Kneif am Kabel!"))
(set 'title-label (to-cstr "KNEIF AM KABEL!"))
(set 'score-label (to-cstr "KABEL"))
(set 'best-label (to-cstr "REKORD"))
(set 'help-label (to-cstr "PFEILE / A D   Spur wechseln     ESC   Beenden"))
(set 'welcome-label (to-cstr "Kabelsalat im Rechenzentrum"))
(set 'rules-label (to-cstr "Fang die Kabel. Meide die Steckdosenleisten."))
(set 'start-label (to-cstr "LEERTASTE   Los!"))
(set 'end-label (to-cstr "Die IT hat dich rausgeworfen."))
(set 'end-dialog-title (to-cstr "Kneif am Kabel: Game Over"))
(set 'restart-label (to-cstr "LEERTASTE   Noch eine Runde"))

(set 'mode 0)
(set 'quit-game false)
(set 'crab-lane 1)
(set 'crab-y 477)
(set 'lives 3)
(set 'score 0)
(set 'best 0)
(set 'score-text (to-cstr "0"))
(set 'best-text (to-cstr "0"))
(set 'wave-count 3)
(set 'drop-y-slots (sequence 'drop-y-0 'drop-y-1 'drop-y-2))
(set 'cable-slots (sequence 'cable-0 'cable-1 'cable-2))
(set 'strip-slots (sequence 'strip-0 'strip-1 'strip-2))
(set 'drop-y-0 0)
(set 'drop-y-1 0)
(set 'drop-y-2 0)
(set 'cable-0 0)
(set 'cable-1 0)
(set 'cable-2 0)
(set 'strip-0 0)
(set 'strip-1 0)
(set 'strip-2 0)
(set 'next-wave 0)
(set 'spawn-in 0)
(set 'fall-speed 5)
(set 'spawn-interval 38)
(set 'spawn-cable 0)
(set 'update-slot 0)
(set 'current-y 0)
(set 'visible-y 0)
(set 'key-space 32)
(set 'key-left 263)
(set 'key-right 262)
(set 'key-a 65)
(set 'key-d 68)

(defun 'lane-x (lane-number) (+ 208 (* lane-number 242)))

(defun 'set-score (new-score)
    (sequence
        (set 'score new-score)
        (free score-text)
        (set 'score-text (to-cstr (string score)))
        (if (> score best)
            (sequence
                (set 'best score)
                (free best-text)
                (set 'best-text (to-cstr (string best)))))))

(defun 'start-round ()
    (sequence
        (DisableEventWaiting)
        (set 'mode 1)
        (set 'crab-lane 1)
        (set 'lives 3)
        (set-score 0)
        (set 'drop-y-0 0)
        (set 'drop-y-1 0)
        (set 'drop-y-2 0)
        (set 'next-wave 0)
        (set 'spawn-in 0)
        (set 'fall-speed 5)
        (set 'spawn-interval 38)))

(defun 'spawn-wave ()
    (sequence
        (set 'spawn-cable (GetRandomValue 0 2))
        (set (list-get cable-slots next-wave) spawn-cable)
        (set (list-get strip-slots next-wave) (% (+ spawn-cable (GetRandomValue 1 2)) 3))
        (set (list-get drop-y-slots next-wave) 126)
        (set 'next-wave (% (+ next-wave 1) wave-count))
        (set 'spawn-in spawn-interval)))

(defun 'resolve-wave (hit-slot)
    (sequence
        (set (list-get drop-y-slots hit-slot) 0)
        (if (== crab-lane (get (list-get cable-slots hit-slot)))
            (sequence
                (set-score (+ score 1))
                (if (and (== (% score 4) 0) (< fall-speed 11))
                    (sequence
                        (set 'fall-speed (+ fall-speed 1))
                        (set 'spawn-interval (- spawn-interval 2)))))
            (if (== crab-lane (get (list-get strip-slots hit-slot)))
                (sequence
                    (set 'lives (- lives 1))
                    (if (== lives 0) (set 'mode 2)))))))

(defun 'finish-round ()
    (sequence
        (show-dialog end-dialog-title end-label 2)
        (if (== dialog-response 2)
            (start-round)
            (if (== dialog-response 1)
                (set 'quit-game true)
                (sequence
                    (set 'mode 3)
                    (EnableEventWaiting))))))

(defun 'advance-wave (moving-slot)
    (sequence
        (set 'current-y (get (list-get drop-y-slots moving-slot)))
        (if (> current-y 0)
            (if (>= (+ current-y fall-speed) crab-y)
                (resolve-wave moving-slot)
                (set (list-get drop-y-slots moving-slot) (+ current-y fall-speed))))))

(defun 'update-round ()
    (sequence
        (if (and (or (IsKeyPressed key-left) (IsKeyPressed key-a)) (> crab-lane 0))
            (set 'crab-lane (- crab-lane 1)))
        (if (and (or (IsKeyPressed key-right) (IsKeyPressed key-d)) (< crab-lane 2))
            (set 'crab-lane (+ crab-lane 1)))
        (if (== spawn-in 0) (spawn-wave) (set 'spawn-in (- spawn-in 1)))
        (set 'update-slot 0)
        (while (and (< update-slot wave-count) (== mode 1))
            (sequence
                (advance-wave update-slot)
                (set 'update-slot (+ update-slot 1))))))

(defun 'draw-track (track-lane)
    (DrawRectangle (- (lane-x track-lane) 104) 109 208 425
        (if (== track-lane crab-lane) active-track track)))

(defun 'draw-cable (cable-x cable-y)
    (sequence
        (DrawRectangle (- cable-x 4) (- cable-y 18) 8 34 mint)
        (DrawRectangle (- cable-x 12) (- cable-y 13) 24 25 mint)
        (DrawRectangle (- cable-x 8) (+ cable-y 2) 3 7 ink)
        (DrawRectangle (- cable-x 2) (+ cable-y 2) 3 7 ink)
        (DrawRectangle (+ cable-x 4) (+ cable-y 2) 3 7 ink)))

(defun 'draw-strip (strip-x strip-y)
    (sequence
        (DrawRectangle (- strip-x 28) (- strip-y 9) 56 19 coral)
        (DrawCircle (- strip-x 13) strip-y 5.0 ink)
        (DrawCircle (+ strip-x 1) strip-y 5.0 ink)
        (DrawCircle (+ strip-x 15) strip-y 5.0 ink)))

(defun 'draw-wave (visible-slot)
    (sequence
        (set 'visible-y (get (list-get drop-y-slots visible-slot)))
        (if (> visible-y 0)
            (sequence
                (draw-cable (lane-x (get (list-get cable-slots visible-slot))) visible-y)
                (draw-strip (lane-x (get (list-get strip-slots visible-slot))) visible-y)))))

(defun 'draw-crab (crab-x)
    (sequence
        (DrawEllipse crab-x (+ crab-y 33) 55.0 8.0 panel)
        (DrawLine (- crab-x 30) (+ crab-y 11) (- crab-x 51) (+ crab-y 25) coral)
        (DrawLine (- crab-x 24) (+ crab-y 15) (- crab-x 42) (+ crab-y 33) coral)
        (DrawLine (+ crab-x 30) (+ crab-y 11) (+ crab-x 51) (+ crab-y 25) coral)
        (DrawLine (+ crab-x 24) (+ crab-y 15) (+ crab-x 42) (+ crab-y 33) coral)
        (DrawEllipse crab-x (+ crab-y 9) 35.0 24.0 dark-coral)
        (DrawEllipse crab-x (+ crab-y 4) 35.0 21.0 coral)
        (DrawCircle (- crab-x 39) (- crab-y 13) 19.0 coral)
        (DrawCircle (+ crab-x 39) (- crab-y 13) 19.0 coral)
        (DrawCircle (- crab-x 33) (- crab-y 27) 9.0 active-track)
        (DrawCircle (+ crab-x 33) (- crab-y 27) 9.0 active-track)
        (DrawEllipse (- crab-x 12) (- crab-y 13) 7.0 12.0 paper)
        (DrawEllipse (+ crab-x 12) (- crab-y 13) 7.0 12.0 paper)
        (DrawCircle (- crab-x 10) (- crab-y 13) 3.0 ink)
        (DrawCircle (+ crab-x 14) (- crab-y 13) 3.0 ink)
        (DrawEllipse crab-x (+ crab-y 7) 7.0 3.0 dark-coral)))

(defun 'draw-centered (center-text center-y center-size center-color)
    (DrawText center-text (- 450 (/ (MeasureText center-text center-size) 2)) center-y center-size center-color))

(defun 'draw-board ()
    (sequence
        (ClearBackground ink)
        (DrawText title-label 38 28 36 gold)
        (DrawText score-label 509 19 16 muted)
        (DrawText score-text 509 39 34 mint)
        (DrawText best-label 628 19 16 muted)
        (DrawText best-text 628 39 34 paper)
        (DrawCircle 771 48 9.0 (if (> lives 0) coral edge))
        (DrawCircle 803 48 9.0 (if (> lives 1) coral edge))
        (DrawCircle 835 48 9.0 (if (> lives 2) coral edge))
        (DrawRectangle 32 88 836 466 panel)
        (draw-track 0)
        (draw-track 1)
        (draw-track 2)
        (DrawLine 104 crab-y 796 crab-y edge)
        (draw-wave 0)
        (draw-wave 1)
        (draw-wave 2)
        (draw-crab (lane-x crab-lane))
        (DrawText help-label 38 571 16 muted)))

(defun 'draw-message ()
    (sequence
        (DrawRectangle 151 198 598 163 ink)
        (DrawRectangle 151 198 598 3 gold)
        (draw-centered (if (== mode 0) welcome-label end-label) 229 29 paper)
        (if (== mode 0) (draw-centered rules-label 273 18 muted))
        (draw-centered (if (== mode 0) start-label restart-label) 318 21 mint)))

(InitWindow 900 610 window-title)
(if (not (IsWindowReady)) (startup-error window-error-text))
(SetTargetFPS 30)
(EnableEventWaiting)
(while (and (not quit-game) (not (WindowShouldClose)))
    (sequence
        (if (== mode 1) (update-round)
            (if (IsKeyPressed key-space) (start-round)))
        (BeginDrawing)
        (draw-board)
        (if (!= mode 1) (draw-message))
        (EndDrawing)
        (if (== mode 2) (finish-round))))
(CloseWindow)
