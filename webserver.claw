;; HTTP server for 64-bit Linux. Run ./claw-cli webserver.claw from the project root.
;; The HTTP code is Claw. Socket and memory operations come from libc.
(defun-foreign 'socket (list c-sint32 c-sint32 c-sint32) c-sint32)
(defun-foreign 'bind (list c-sint32 c-pointer c-uint32) c-sint32)
(defun-foreign 'listen (list c-sint32 c-sint32) c-sint32)
(defun-foreign 'accept (list c-sint32 c-pointer c-pointer) c-sint32)
(defun-foreign 'recv (list c-sint32 c-pointer c-uint64 c-sint32) c-sint64)
(defun-foreign 'send (list c-sint32 c-pointer c-uint64 c-sint32) c-sint64)
(defun-foreign 'close (list c-sint32) c-sint32)
(defun-foreign 'setsockopt (list c-sint32 c-sint32 c-sint32 c-pointer c-uint32) c-sint32)
(defun-foreign 'htons (list c-uint16) c-uint16)
(defun-foreign 'inet_pton (list c-sint32 c-pointer c-pointer) c-sint32)
(defun-foreign 'calloc (list c-uint64 c-uint64) c-pointer)
(defun-foreign 'free (list c-pointer) c-void)
(defun-foreign 'memset (list c-pointer c-sint32 c-uint64) c-pointer)
(defun-foreign 'strlen (list c-pointer) c-uint64)
(defun-foreign 'strcat (list c-pointer c-pointer) c-pointer)
(defun-foreign 'strcmp (list c-pointer c-pointer) c-sint32)
(defun-foreign 'strstr (list c-pointer c-pointer) c-pointer)
(defun-foreign 'strchr (list c-pointer c-sint32) c-pointer)
(defun-foreign 'perror (list c-pointer) c-void)
(defun-foreign 'puts (list c-pointer) c-sint32)
(defun-foreign 'fflush (list c-pointer) c-sint32)
(defun-foreign '_exit (list c-sint32) c-void)

(set 'port 8080)
(set 'max-request-size 8192)
(set 'af-inet 2)
(set 'sock-stream 1)
(set 'sol-socket 1)
(set 'so-reuseaddr 2)
(set 'so-rcvtimeo 20)
(set 'so-sndtimeo 21)
(set 'msg-nosignal 0x4000)

(defun 'check-system (system-result system-operation)
    (if (< system-result 0)
        (list (perror (to-cstr system-operation)) (_exit 1))))

(defun 'alloc (alloc-size)
    (if (== (set 'allocation (calloc alloc-size 1)) 0)
        (list (perror (to-cstr "calloc")) (_exit 1))
        allocation))

(set 'crlf (alloc 3))
(memset crlf 13 1)
(memset (+ crlf 1) 10 1)
(set 'header-end (alloc 5))
(strcat header-end crlf)
(strcat header-end crlf)

(set 'get-method (to-cstr "GET"))
(set 'head-method (to-cstr "HEAD"))
(set 'http-1-0 (to-cstr "HTTP/1.0"))
(set 'http-1-1 (to-cstr "HTTP/1.1"))
(set 'index-path (to-cstr "/"))
(set 'health-path (to-cstr "/health"))
(set 'plain-text "text/plain; charset=utf-8")
(set 'index-page (to-cstr (file-read "index.html")))
(set 'health-body (to-cstr "ok"))
(set 'bad-request-body (to-cstr "Bad Request"))
(set 'not-found-body (to-cstr "Not Found"))
(set 'method-not-allowed-body (to-cstr "Method Not Allowed"))
(set 'header-too-large-body (to-cstr "Request Header Fields Too Large"))

(defun 'append-text (append-buffer append-string)
    (list
        (set 'append-source (to-cstr append-string))
        (strcat append-buffer append-source)
        (free append-source)))

(defun 'send-all (send-client send-buffer)
    (list
        (set 'send-offset 0)
        (set 'send-size (strlen send-buffer))
        (set 'send-active true)
        (while (and send-active (< send-offset send-size))
            (list
                (set 'send-count (send send-client (+ send-buffer send-offset) (- send-size send-offset) msg-nosignal))
                (if (> send-count 0)
                    (set 'send-offset (+ send-offset send-count))
                    (set 'send-active false))))))

(defun 'respond (response-client response-status response-type response-body response-head response-allow)
    (list
        (set 'response-length (strlen response-body))
        (set 'response-status-text (to-cstr response-status))
        (set 'response-type-text (to-cstr response-type))
        ;; Allow room for the fixed headers, line endings, length digits and terminator.
        (set 'response-header-size (+ 128 (+ (strlen response-status-text) (strlen response-type-text))))
        (set 'response-buffer (alloc (+ response-header-size (if response-head 0 response-length))))
        (append-text response-buffer "HTTP/1.1 ")
        (strcat response-buffer response-status-text)
        (strcat response-buffer crlf)
        (append-text response-buffer "Content-Type: ")
        (strcat response-buffer response-type-text)
        (strcat response-buffer crlf)
        (append-text response-buffer "Content-Length: ")
        (append-text response-buffer (string response-length))
        (strcat response-buffer crlf)
        (append-text response-buffer "Connection: close")
        (strcat response-buffer crlf)
        (if response-allow
            (list (append-text response-buffer "Allow: GET, HEAD") (strcat response-buffer crlf)))
        (strcat response-buffer crlf)
        (if (not response-head) (strcat response-buffer response-body))
        (send-all response-client response-buffer)
        (free response-buffer)
        (free response-status-text)
        (free response-type-text)))

(defun 'bad-request (bad-client)
    (respond bad-client "400 Bad Request" plain-text bad-request-body false false))

(defun 'dispatch (dispatch-client dispatch-method dispatch-target dispatch-version)
    (if (and (or (== (strcmp dispatch-version http-1-1) 0) (== (strcmp dispatch-version http-1-0) 0))
             (== (strchr dispatch-target 47) dispatch-target)
             (> (strlen dispatch-method) 0))
        (list
            (set 'dispatch-query (strchr dispatch-target 63))
            (if (!= dispatch-query 0) (memset dispatch-query 0 1))
            (set 'dispatch-head (== (strcmp dispatch-method head-method) 0))
            (if (or dispatch-head (== (strcmp dispatch-method get-method) 0))
                (if (== (strcmp dispatch-target index-path) 0)
                    (respond dispatch-client "200 OK" "text/html; charset=utf-8" index-page dispatch-head false)
                    (if (== (strcmp dispatch-target health-path) 0)
                        (respond dispatch-client "200 OK" plain-text health-body dispatch-head false)
                        (respond dispatch-client "404 Not Found" plain-text not-found-body dispatch-head false)))
                (respond dispatch-client "405 Method Not Allowed" plain-text method-not-allowed-body false true)))
        (bad-request dispatch-client)))

(defun 'handle-request-line (line-client line-buffer)
    (list
        (set 'line-end (strstr line-buffer crlf))
        (memset line-end 0 1)
        (set 'line-first-space (strchr line-buffer 32))
        (if (== line-first-space 0)
            (bad-request line-client)
            (list
                (set 'line-target (+ line-first-space 1))
                (set 'line-second-space (strchr line-target 32))
                (if (== line-second-space 0)
                    (bad-request line-client)
                    (list
                        (memset line-first-space 0 1)
                        (memset line-second-space 0 1)
                        (dispatch line-client line-buffer line-target (+ line-second-space 1))))))))

(defun 'handle-client (request-client)
    (list
        (set 'request-buffer (alloc (+ max-request-size 1)))
        (set 'request-length 0)
        (set 'request-complete false)
        (set 'request-open true)
        (while (and request-open (not request-complete) (< request-length max-request-size))
            (list
                (set 'request-count
                    (recv request-client (+ request-buffer request-length) (- max-request-size request-length) 0))
                (if (> request-count 0)
                    (list
                        (set 'request-length (+ request-length request-count))
                        (set 'request-complete (!= (strstr request-buffer header-end) 0)))
                    (set 'request-open false))))
        (if request-complete
            (handle-request-line request-client request-buffer)
            (if (== request-length max-request-size)
                (respond request-client "431 Request Header Fields Too Large" plain-text header-too-large-body false false)
                (if (> request-length 0) (bad-request request-client))))
        (free request-buffer)))

(set 'little-endian (!= (htons 1) 1))
(set 'server-address (alloc 16))
;; sockaddr_in contains a native-endian family, then the network-endian port and address.
(memset (+ server-address (if little-endian 0 1)) af-inet 1)
(memset (+ server-address 2) (/ port 256) 1)
(memset (+ server-address 3) (% port 256) 1)
(set 'loopback (to-cstr "127.0.0.1"))
(check-system (inet_pton af-inet loopback (+ server-address 4)) "inet_pton")
(free loopback)

(set 'server-socket (socket af-inet sock-stream 0))
(check-system server-socket "socket")
(set 'reuse-option (alloc 4))
(memset reuse-option 1 4)
(check-system (setsockopt server-socket sol-socket so-reuseaddr reuse-option 4) "SO_REUSEADDR")
(free reuse-option)
(check-system (bind server-socket server-address 16) "bind")
(free server-address)
(check-system (listen server-socket 32) "listen")

;; Linux uses two native long fields in timeval on 64-bit systems.
(set 'timeout (alloc 16))
(memset (+ timeout (if little-endian 0 7)) 3 1)
(set 'startup-message (alloc 64))
(append-text startup-message "Claw-Webserver auf http://127.0.0.1:")
(append-text startup-message (string port))
(puts startup-message)
(free startup-message)
(fflush 0)
(while true
    (list
        (set 'client (accept server-socket 0 0))
        (if (>= client 0)
            (list
                (setsockopt client sol-socket so-rcvtimeo timeout 16)
                (setsockopt client sol-socket so-sndtimeo timeout 16)
                (handle-client client)
                (close client))
            (check-system client "accept"))))
